<!doctype html>
<html lang="ko" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.shortName) if title else (site.name + " | 사면·지반 보강 전문건설") %}
{%- set pageDesc = description or site.description %}
{%- set canonical = site.url + page.url %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="naver-site-verification" content="{{ site.naverVerification }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
{%- set ogName = ogImage or cover or site.ogImage %}
{%- if ogName %}<meta property="og:image" content="{{ site.url }}{% photoUrl ogName %}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0f1112">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="/assets/css/site.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.tel }}",
  "faxNumber": "{{ site.fax }}",
  "email": "{{ site.email }}",
  "foundingDate": "{{ site.since }}",
  "address": { "@type": "PostalAddress", "streetAddress": "한천로 66길 189, 브룩스톤 오피스텔 307호", "addressLocality": "성북구", "addressRegion": "서울특별시", "addressCountry": "KR" }
}
</script>
</head>
<body>
<a class="skip" href="#main">본문 바로가기</a>
<header class="site-header{% if not isHome %} solid{% endif %}">
  <div class="wrap nav">
    <a class="logo" href="/" aria-label="{{ site.name }} 처음으로"><i></i>{{ site.shortName }}</a>
    <nav aria-label="주 메뉴">
      <ul class="gnb">
        {%- for m in nav %}
        <li class="{% if page.url | isActive(m.prefix) %}on{% endif %}">
          <a href="{{ m.url }}">{{ m.title }}</a>
          <ul>
            {%- for c in m.children %}
            <li><a href="{{ c.url }}"{% if c.url == page.url %} aria-current="page"{% endif %}>{{ c.title }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- endfor %}
      </ul>
    </nav>
    <a class="call" href="{{ site.tel | telHref }}">{{ site.tel }}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="메뉴 열기"><span></span></button>
  </div>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="모바일 메뉴">
  <ul>
    {%- for m in nav %}
    <li><a href="{{ m.url }}">{{ m.title }}</a>
      <ul>{% for c in m.children %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}</ul>
    </li>
    {%- endfor %}
  </ul>
</nav>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div>
      <strong>{{ site.name }}</strong><br>
      대표 {{ site.ceo }} · 사업자등록번호 {{ site.bizNumber }}<br>
      {{ site.address }}
    </div>
    <div>
      TEL <a href="{{ site.tel | telHref }}">{{ site.tel }}</a> · H.P <a href="{{ site.mobile | telHref }}">{{ site.mobile }}</a> · FAX {{ site.fax }}<br>
      {{ site.email }}<br>
      © {{ site.shortName }}. All rights reserved.
    </div>
  </div>
</footer>
<div class="mobile-bar"><a href="{{ site.tel | telHref }}">전화 문의</a><a href="/contact/">이메일 문의</a></div>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
